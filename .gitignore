.externalNativeBuild/
.cxx/

# Google Services (uncomment if using)
# google-services.json

# OS-specific
.DS_Store
Thumbs.db

# Log files
*.log

# Kotlin
.kotlin/

# Node (if used for tooling)
node_modules/
