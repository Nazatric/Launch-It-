<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme using Material3 via Compose -->
    <style name="Theme.LaunchIt" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Fullscreen player theme for project execution -->
    <style name="Theme.LaunchIt.Player" parent="Theme.LaunchIt">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
